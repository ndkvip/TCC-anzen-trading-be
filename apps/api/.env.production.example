# Render API + Neon PostgreSQL
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_SSL=true
DATABASE_MIGRATIONS_RUN=true
DATABASE_SYNCHRONIZE=false

# Generate long random values; never reuse local secrets.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=ANZEN TRADING Admin
ADMIN_ORIGIN=https://anzen-trading-admin-demo.onrender.com
ADMIN_RESET_URL=https://anzen-trading-admin-demo.onrender.com/reset-password

# Render Free blocks outbound SMTP ports, so use Brevo HTTPS API for OTP/reset email.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=ANZEN TRADING
AUTH_EXPOSE_OTP=false

# Google Drive is the canonical media store.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=

FOREX_FACTORY_SYNC_ENABLED=true
FOREX_FACTORY_SYNC_INTERVAL_MINUTES=30
FOREX_FACTORY_CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
