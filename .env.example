# Local development
PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://ttc_ict:ttc_ict@localhost:5432/ttc_ict
DATABASE_SSL=false
# Schema is managed by TypeORM migrations. Keep false after the first setup.
DATABASE_SYNCHRONIZE=false
DATABASE_MIGRATIONS_RUN=true
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
ADMIN_EMAIL=admin@ttc-ict.vn
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=ANZEN TRADING Admin
ADMIN_ORIGIN=http://localhost:3000
ADMIN_RESET_URL=http://localhost:3000/reset-password
# Leave SMTP_HOST empty locally to log OTP in the API terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ANZEN TRADING <no-reply@ttc-ict.vn>
# Render Free blocks outbound SMTP ports. Use Brevo HTTPS API for deployed demo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=ANZEN TRADING
# true only for local OTP testing; set false when real SMTP is configured.
AUTH_EXPOSE_OTP=true

# Google Drive is the canonical media store. OAuth is preferred for a personal Drive;
# Service Account credentials are kept as a fallback for Shared Drives.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=


# Automatically import only high-impact event metadata from the calendar feed.
# No event description is copied. Disable for environments that require manual admin entry.
FOREX_FACTORY_SYNC_ENABLED=true
FOREX_FACTORY_SYNC_INTERVAL_MINUTES=30
FOREX_FACTORY_CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json

# Google Drive media storage. Use OAuth credentials for a personal Drive.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
